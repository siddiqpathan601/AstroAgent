# ── LLM Providers ─────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here          # Required — get free at console.groq.com

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=7860                                    # 7860 is required for Hugging Face Spaces
HOST=0.0.0.0

# ── Debug mode (set to "true" for local dev auto-reload) ──────────────────────
DEBUG=false

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Use "*" for open access (demo) or your deployed frontend URL for production.
# Example: https://your-username-astroagent-frontend.hf.space
CORS_ORIGINS=*
